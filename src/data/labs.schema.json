{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Backblaze Labs Catalog",
  "type": "object",
  "required": ["version", "meta", "categories", "types", "languages", "integrations"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "tagline", "description", "github"],
      "properties": {
        "title": { "type": "string" },
        "homeTitle": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "github": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "b2": { "type": "string", "format": "uri" }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "icon": { "type": "string" }
        }
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "tagline",
          "description",
          "categories",
          "type",
          "languages",
          "url"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "tagline": { "type": "string", "maxLength": 80 },
          "description": { "type": "string" },
          "categories": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "type": { "type": "string" },
          "languages": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "repo": { "type": ["string", "null"], "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "source": { "type": ["string", "null"] },
          "url": { "type": "string", "format": "uri" },
          "site": { "type": ["string", "null"], "format": "uri" },
          "docs": { "type": ["string", "null"], "format": "uri" },
          "demo": { "type": ["string", "null"], "format": "uri" },
          "example": { "type": ["string", "null"], "format": "uri" },
          "preview": { "type": ["string", "null"] },
          "icon": { "type": "string" },
          "featured": { "type": "boolean" },
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metaDescription",
              "audience",
              "license",
              "techStack",
              "screenshots",
              "capabilities",
              "useWhen",
              "avoidWhen",
              "maturity"
            ],
            "properties": {
              "metaDescription": { "type": "string", "maxLength": 180 },
              "audience": { "type": "string" },
              "license": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "url"],
                "properties": {
                  "name": { "type": "string" },
                  "url": { "type": "string", "format": "uri" }
                }
              },
              "techStack": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "role"],
                  "properties": {
                    "name": { "type": "string" },
                    "role": { "type": "string" }
                  }
                }
              },
              "screenshots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["src", "alt", "caption", "width", "height"],
                  "properties": {
                    "src": { "type": "string" },
                    "alt": { "type": "string" },
                    "caption": { "type": "string" },
                    "width": { "type": "integer", "minimum": 1 },
                    "height": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "description"],
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "useWhen": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "avoidWhen": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "maturity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "support"],
                "properties": {
                  "status": { "type": "string" },
                  "support": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
