---
import Filters from "~/components/Filters.astro";
import IntegrationCard from "~/components/IntegrationCard.astro";
import Icon from "~/components/Icon.astro";
import { catalog, sortIntegrations, statsFor } from "~/lib/labs";

// Sort order: featured → has-real-image → alphabetical, with awesome lists
// (type "list") always sunk to the bottom. The "image first" tier means a wall
// of branded preview artwork loads in the visible region before the
// placeholder-gradient cards drop in below.
const sorted = sortIntegrations(catalog.integrations);
const missingStats = sorted.filter((item) => item.repo && !statsFor(item.id));
if (missingStats.length > 0) {
  console.warn(
    `Backblaze Labs: ${missingStats.length} catalogued repos have no github-stats entry: ${missingStats
      .map((item) => item.id)
      .join(", ")}`,
  );
}
const sortModes = [
  {
    id: "featured",
    label: "Featured",
    description: "Featured projects first, then preview cards, then A-Z; awesome lists last.",
  },
  { id: "stars", label: "Most stars", description: "GitHub stars, descending." },
  { id: "name", label: "Name A-Z", description: "Project title, alphabetical." },
  { id: "updated", label: "Recently updated", description: "GitHub updated date, newest first." },
];
---
<section id="integrations" class="container-page mt-12 md:mt-16">
  <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">
        Find your integration
      </h2>
      <p class="mt-1 text-sm md:text-base" style="color: var(--fg-muted);">
        {catalog.integrations.length} open source projects working with Backblaze B2 —
        from Backblaze Labs and the community.
      </p>
    </div>

    <div class="search-shell">
      <span class="search-icon" aria-hidden="true"><Icon name="search" size={16} /></span>
      <input
        type="search"
        data-search
        placeholder="Search by name, language, tag…"
        aria-label="Search integrations"
        autocomplete="off"
      />
      <kbd class="hidden sm:inline-flex" aria-hidden="true">/</kbd>
    </div>
  </div>

  <!-- mobile filters toggle -->
  <button
    type="button"
    data-filters-toggle
    class="md:hidden btn-secondary mb-4 w-full justify-center"
  >
    <Icon name="filter" size={16} /> <span data-filters-toggle-label>Show filters</span>
  </button>

  <div class="gallery-grid">
    <div class="gallery-filters" data-filters-wrap>
      <Filters />
    </div>
    <div>
      <div class="mb-3 flex items-center justify-between gap-3 text-sm" style="color: var(--fg-muted);">
        <span><span data-result-count>{catalog.integrations.length}</span> shown</span>
        <div class="sort-control">
          <label for="sort-select" class="sort-label">Sort</label>
          <div class="sort-field">
            <select id="sort-select" data-sort aria-describedby="sort-help">
              {sortModes.map((mode) => (
                <option value={mode.id} title={mode.description} data-description={mode.description}>
                  {mode.label}
                </option>
              ))}
            </select>
            <svg class="sort-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </div>
          <span id="sort-help" class="sr-only">
            Featured sorts featured projects first, then preview cards, then A-Z; awesome lists last.
          </span>
        </div>
      </div>
      <div class="mb-3 hidden flex-wrap gap-1.5 sm:flex">
        <span class="text-xs" style="color: var(--fg-dim);">Quick filters:</span>
        {catalog.categories.slice(0, 4).map((c) => (
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/category/${c.id}`} class="chip text-xs transition hover:border-[var(--border-strong)]">
            {c.label}
          </a>
        ))}
      </div>
      <div class="cards-grid" data-cards>
        {sorted.map((item, i) => (
          <IntegrationCard item={item} index={i} />
        ))}
      </div>
      <noscript>
        <style>
          [data-card][hidden] {
            display: flex !important;
          }
        </style>
      </noscript>
      <div data-empty class="empty-state hidden">
        <p class="font-display text-lg font-semibold">No matches</p>
        <p class="mt-1 text-sm" style="color: var(--fg-muted);">Try clearing a filter or adjusting your search.</p>
        <button type="button" data-filter-clear class="btn-secondary mt-4">Clear filters</button>
      </div>
      <!-- Infinite scroll sentinel: when it enters the viewport we reveal the
           next page of matching cards. Zero-height and aria-hidden so it's
           invisible to layout and assistive tech. -->
      <div data-sentinel aria-hidden="true"></div>
      <p data-pager-status class="mt-8 hidden text-center text-xs" style="color: var(--fg-dim);">
        Showing <span data-pager-shown>0</span> of <span data-pager-total>0</span>
      </p>
    </div>
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: 240px 1fr;
      gap: 2rem;
    }
  }
  @media (min-width: 1280px) {
    .gallery-grid {
      grid-template-columns: 260px 1fr;
    }
  }
  .gallery-filters {
    display: none;
  }
  .gallery-filters.is-open {
    display: block;
  }
  @media (min-width: 768px) {
    .gallery-filters {
      display: block;
    }
  }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px)  { .cards-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .cards-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; } }

  .search-shell {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 380px;
  }
  .search-shell .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    color: var(--fg-dim);
    pointer-events: none;
    z-index: 1;
  }
  .search-shell input {
    width: 100%;
    background: var(--bg-input);
    border: 1px solid var(--border);
    color: var(--fg);
    border-radius: 999px;
    padding: 0.65rem 2.6rem 0.65rem 2.4rem;
    font-size: 0.92rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .search-shell input::placeholder { color: var(--fg-dim); }
  .search-shell input:focus {
    outline: none;
    border-color: var(--color-red-50);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-red-50) 25%, transparent);
  }
  .search-shell kbd {
    position: absolute;
    right: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-dim);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.05rem 0.4rem;
    background: var(--bg-elevated);
  }
  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
  }
  .sort-control {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .sort-label { color: var(--fg-dim); }
  .sort-field { position: relative; display: inline-flex; align-items: center; }
  .sort-field select {
    appearance: none;
    -webkit-appearance: none;
    padding: 0.4rem 1.7rem 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .sort-field select:hover { border-color: var(--border-strong); }
  .sort-field select:focus-visible {
    outline: none;
    border-color: var(--color-red-50);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-red-50) 25%, transparent);
  }
  .sort-caret {
    position: absolute;
    right: 0.65rem;
    color: var(--fg-muted);
    pointer-events: none;
  }
</style>

<script is:inline>
(() => {
  const root = document.querySelector("[data-cards]");
  if (!root) return;
  const cards = Array.from(root.querySelectorAll("[data-card]"));
  const search = document.querySelector("[data-search]");
  const checkboxes = Array.from(document.querySelectorAll("input[data-filter]"));
  const countEl = document.querySelector("[data-result-count]");
  const empty = document.querySelector("[data-empty]");
  const grid = root;
  const filtersWrap = document.querySelector("[data-filters-wrap]");
  const filtersToggle = document.querySelector("[data-filters-toggle]");
  const filtersToggleLabel = document.querySelector("[data-filters-toggle-label]");
  const sentinel = document.querySelector("[data-sentinel]");
  const pagerStatus = document.querySelector("[data-pager-status]");
  const pagerShown = document.querySelector("[data-pager-shown]");
  const pagerTotal = document.querySelector("[data-pager-total]");
  const sortSelect = document.querySelector("[data-sort]");

  // Client-side sort. Cards render in build-time `sortIntegrations` order (the
  // "Featured" default, captured as data-order); other modes reorder the card
  // DOM so the filter/pagination pass reveals matches in the chosen order.
  const orderOf = (el) => Number.parseInt(el.dataset.order || "0", 10);
  const numOr = (v, fallback) => {
    const n = Number.parseFloat(v);
    return Number.isFinite(n) ? n : fallback;
  };
  const timeOr = (v, fallback) => {
    const t = Date.parse(v || "");
    return Number.isNaN(t) ? fallback : t;
  };
  const statsGroup = (el) => {
    if (el.dataset.hasRepo !== "1") return 2;
    return el.dataset.hasStats === "1" ? 0 : 1;
  };
  const compareStatsField = (a, b, valueOf) => {
    // Known stats sort first. Repos awaiting stats keep Featured order, ahead
    // of upstream integrations with no repo/stats by design.
    const groupDiff = statsGroup(a) - statsGroup(b);
    if (groupDiff !== 0) return groupDiff;
    if (statsGroup(a) !== 0) return orderOf(a) - orderOf(b);
    const d = valueOf(b) - valueOf(a);
    return d !== 0 ? d : orderOf(a) - orderOf(b);
  };
  const SORT_COMPARATORS = {
    featured: (a, b) => orderOf(a) - orderOf(b),
    stars: (a, b) => compareStatsField(a, b, (el) => numOr(el.dataset.stars, 0)),
    name: (a, b) => {
      const d = (a.dataset.name || "").localeCompare(b.dataset.name || "");
      return d !== 0 ? d : orderOf(a) - orderOf(b);
    },
    updated: (a, b) => compareStatsField(a, b, (el) => timeOr(el.dataset.updated, 0)),
  };
  const SORT_KEYS = new Set(Object.keys(SORT_COMPARATORS));
  const renderedSortKeys = sortSelect ? Array.from(sortSelect.options).map((option) => option.value) : [];

  function validateSortConfig() {
    if (!sortSelect) return;
    const rendered = new Set(renderedSortKeys);
    const missingComparators = renderedSortKeys.filter((key) => !SORT_KEYS.has(key));
    const missingOptions = [...SORT_KEYS].filter((key) => !rendered.has(key));
    if (missingComparators.length || missingOptions.length) {
      console.error(
        `Gallery sort configuration mismatch: options without comparators [${missingComparators.join(", ")}]; comparators without options [${missingOptions.join(", ")}].`
      );
    }
  }

  function sortModeOrDefault(mode) {
    return SORT_KEYS.has(mode) ? mode : "featured";
  }

  function updateSortDescription() {
    if (!sortSelect) return;
    const description = sortSelect.selectedOptions[0]?.dataset.description;
    if (description) sortSelect.title = description;
  }

  function sortCards(mode) {
    cards.sort(SORT_COMPARATORS[sortModeOrDefault(mode)]);
    const frag = document.createDocumentFragment();
    for (const card of cards) frag.appendChild(card);
    root.appendChild(frag);
  }

  // How many filtered-matching cards to render at once. Filter + search apply
  // across the FULL set; only the slice that's actually visible is rendered.
  // Additional pages are revealed automatically as the sentinel scrolls into
  // view (see the IntersectionObserver below).
  const PAGE_SIZE = 12;
  let pageLimit = PAGE_SIZE;
  // Set by apply(): whether unrendered matches remain to reveal on scroll.
  let hasMore = false;

  const filterParams = {
    category: { canonical: "category", aliases: ["category", "categories", "cat"] },
    type: { canonical: "type", aliases: ["type", "types"] },
    language: { canonical: "language", aliases: ["language", "languages", "lang"] },
  };
  const allFilterParamNames = [
    "q",
    "search",
    "sort",
    ...Object.values(filterParams).flatMap((config) => config.aliases),
  ];

  function splitParamValue(value) {
    return value
      .split(",")
      .map((part) => part.trim())
      .filter(Boolean);
  }

  function valuesForParams(params, names) {
    const values = [];
    for (const name of names) {
      for (const raw of params.getAll(name)) values.push(...splitParamValue(raw));
    }
    return values;
  }

  function applyUrlState() {
    const params = new URLSearchParams(window.location.search);
    if (search) search.value = params.get("q") ?? params.get("search") ?? "";
    for (const cb of checkboxes) cb.checked = false;
    for (const [kind, config] of Object.entries(filterParams)) {
      const requested = new Set(valuesForParams(params, config.aliases));
      if (requested.size === 0) continue;
      for (const cb of checkboxes) {
        if (cb.dataset.filter === kind && requested.has(cb.value)) cb.checked = true;
      }
    }
    if (sortSelect) {
      const sortParam = params.get("sort");
      sortSelect.value = sortParam ? sortModeOrDefault(sortParam) : "featured";
      updateSortDescription();
    }
  }

  function updateUrlState(historyMode = "replace") {
    const url = new URL(window.location.href);
    for (const name of allFilterParamNames) url.searchParams.delete(name);

    const q = (search?.value || "").trim();
    if (q) url.searchParams.set("q", q);

    const active = getActive();
    for (const [kind, config] of Object.entries(filterParams)) {
      for (const value of [...active[kind]].sort()) {
        url.searchParams.append(config.canonical, value);
      }
    }

    const sortVal = sortSelect?.value || "featured";
    if (sortVal !== "featured") url.searchParams.set("sort", sortVal);

    const next = `${url.pathname}${url.search}${url.hash}`;
    const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (next !== current) {
      const method = historyMode === "push" ? "pushState" : "replaceState";
      window.history[method]({ galleryFilters: true }, "", next);
    }
  }

  validateSortConfig();

  // Pre-populate filter state from query params so URLs like
  // `?q=ray&category=notebooks&type=integration&language=python` are shareable.
  applyUrlState();

  // Apply the sort mode from the URL (or default) before the first render.
  if (sortSelect) sortCards(sortSelect.value);
  // Render the initial page slice synchronously so shared filter/sort URLs
  // never show mismatched SSR visibility after the client reorders cards.
  apply();

  // Mobile show/hide filters.
  if (filtersToggle && filtersWrap) {
    filtersToggle.addEventListener("click", () => {
      const open = filtersWrap.classList.toggle("is-open");
      if (filtersToggleLabel) filtersToggleLabel.textContent = open ? "Hide filters" : "Show filters";
    });
  }

  function getActive() {
    const sets = { category: new Set(), type: new Set(), language: new Set() };
    for (const cb of checkboxes) {
      if (cb.checked) sets[cb.dataset.filter].add(cb.value);
    }
    return sets;
  }

  // Pure filter test — no DOM mutation. Lets us count the FULL set of matches
  // before deciding the visible slice.
  function matches(card) {
    const q = (search?.value || "").trim().toLowerCase();
    const { category, type, language } = getActive();
    const cats = (card.dataset.categories || "").split(" ");
    const t = card.dataset.type || "";
    const languages = (card.dataset.languages || "").split(" ");
    const text = card.dataset.search || "";
    const okCat = category.size === 0 || cats.some((c) => category.has(c));
    const okType = type.size === 0 || type.has(t);
    const okLang = language.size === 0 || languages.some((l) => language.has(l));
    const okSearch = q === "" || text.includes(q);
    return okCat && okType && okLang && okSearch;
  }

  function apply() {
    let totalMatching = 0;
    let shown = 0;
    for (const card of cards) {
      if (!matches(card)) {
        card.hidden = true;
        continue;
      }
      totalMatching++;
      // Show the first `pageLimit` matches; hide the rest until scrolled into view.
      if (shown < pageLimit) {
        card.hidden = false;
        shown++;
      } else {
        card.hidden = true;
      }
    }
    if (countEl) countEl.textContent = String(totalMatching);
    if (empty) empty.classList.toggle("hidden", totalMatching !== 0);
    grid.classList.toggle("hidden", totalMatching === 0);
    // Drive the infinite-scroll trigger and the "Showing X of Y" status line.
    hasMore = totalMatching > shown;
    if (pagerStatus) {
      pagerStatus.classList.toggle("hidden", totalMatching === 0);
      if (pagerShown) pagerShown.textContent = String(shown);
      if (pagerTotal) pagerTotal.textContent = String(totalMatching);
    }
  }

  // Reveal pages until the sentinel sits below the preload band or nothing is
  // left. The rAF loop re-measures after each reveal so that on tall viewports
  // (where one page doesn't fill the gap) we keep loading without waiting for
  // another scroll event.
  function fill() {
    if (!hasMore) return;
    const rect = sentinel?.getBoundingClientRect();
    if (rect && rect.top <= window.innerHeight + 600) {
      pageLimit += PAGE_SIZE;
      apply();
      requestAnimationFrame(fill);
    }
  }

  function clearAll() {
    for (const cb of checkboxes) cb.checked = false;
    if (search) search.value = "";
    pageLimit = PAGE_SIZE;
    updateUrlState();
    apply();
    fill();
  }

  // Infinite scroll: reveal the next page whenever the sentinel nears the
  // viewport. Falls back to rendering everything up front if the browser lacks
  // IntersectionObserver, so the full catalog stays reachable without JS paging.
  if (sentinel && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) fill();
      },
      { rootMargin: "600px 0px" }
    );
    io.observe(sentinel);
  } else {
    pageLimit = cards.length;
  }

  // When filters or search change, reset to the first page — otherwise the
  // revealed-page count from a previous filter would leak through.
  for (const cb of checkboxes) {
    cb.addEventListener("change", () => {
      pageLimit = PAGE_SIZE;
      updateUrlState();
      apply();
      fill();
      if (window.bbTrack && cb.checked) {
        window.bbTrack("filter_change", { filter: cb.dataset.filter, value: cb.value });
      }
    });
  }
  let searchTimer = 0;
  if (search) {
    search.addEventListener("input", () => {
      pageLimit = PAGE_SIZE;
      updateUrlState();
      apply();
      fill();
      // Debounce search-term events so we don't fire on every keystroke.
      clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        const q = (search.value || "").trim();
        if (q.length >= 2 && window.bbTrack) {
          window.bbTrack("search", { search_term: q.slice(0, 80) });
        }
      }, 700);
    });
  }
  document.querySelectorAll("[data-filter-clear]").forEach((b) => b.addEventListener("click", clearAll));

  if (sortSelect) {
    sortSelect.addEventListener("change", () => {
      updateSortDescription();
      sortCards(sortSelect.value);
      pageLimit = PAGE_SIZE;
      updateUrlState("push");
      apply();
      fill();
      if (window.bbTrack) window.bbTrack("sort_change", { sort: sortSelect.value });
    });
  }

  window.addEventListener("popstate", () => {
    applyUrlState();
    if (sortSelect) sortCards(sortSelect.value);
    pageLimit = PAGE_SIZE;
    apply();
    fill();
  });

  // Top up to fill tall viewports. Deferred until idle so the post-render
  // measurement loop doesn't compete with the browser's first paint.
  const firstPaint = () => {
    fill();
  };
  if ("requestIdleCallback" in window) {
    requestIdleCallback(firstPaint, { timeout: 200 });
  } else {
    setTimeout(firstPaint, 0);
  }

  // "/" focuses search.
  document.addEventListener("keydown", (e) => {
    const target = e.target;
    const isInput = target instanceof HTMLElement && (target.tagName === "INPUT" || target.tagName === "TEXTAREA");
    if (e.key === "/" && !isInput) {
      e.preventDefault();
      search?.focus();
    }
  });
})();
</script>
